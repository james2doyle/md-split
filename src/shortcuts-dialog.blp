using Gtk 4.0;
using Adw 1;

Adw.ShortcutsDialog shortcuts_dialog {
  Adw.ShortcutsSection {
    title: _("Documents");

    Adw.ShortcutsItem {
      title: C_("shortcut window", "New Document");
      action-name: "app.new";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Open");
      action-name: "app.open";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Save");
      action-name: "app.save";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Save As");
      action-name: "app.save-as";
    }
  }

  Adw.ShortcutsSection {
    title: _("Search");

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Find");
      action-name: "app.find";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Find Next");
      action-name: "app.find-next";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Find Previous");
      action-name: "app.find-previous";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Replace");
      action-name: "app.replace";
    }
  }

  Adw.ShortcutsSection {
    title: _("View");

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Cycle View");
      action-name: "app.cycle-view";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Show Shortcuts");
      action-name: "app.shortcuts";
    }
  }

  Adw.ShortcutsSection {
    title: _("Formatting");

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Bold");
      action-name: "app.format-bold";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Italic");
      action-name: "app.format-italic";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Underline");
      action-name: "app.format-underline";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Block Quote");
      action-name: "app.format-blockquote";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Code");
      action-name: "app.format-code";
    }
  }

  Adw.ShortcutsSection {
    title: _("Application");

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Preferences");
      action-name: "app.preferences";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Quit");
      action-name: "app.quit";
    }
  }
}
