{
    "id": "io.github.james2doyle.MdSplit",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "command": "md_split",
    "finish-args": [
        "--share=ipc",
        "--share=network",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--filesystem=home"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules": [
        {
            "name": "libspelling",
            "buildsystem": "meson",
            "config-opts": [
                "--libdir=lib",
                "-Ddocs=false",
                "-Dintrospection=enabled",
                "-Dvapi=false",
                "-Dsysprof=false"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/libspelling/0.4/libspelling-0.4.11.tar.xz",
                    "sha256": "52e53ec3fba0f604cfd0931e26af7f7241a0d4f0208dd5574f43b3589f6d28b2"
                }
            ]
        },
        {
            "name": "md_split",
            "builddir": true,
            "buildsystem": "meson",
            "license-files": ["COPYING"],
            "sources": [
                {
                    "type": "dir",
                    "path": ".",
                    "skip": [
                        ".git",
                        ".gitignore",
                        "build",
                        "build-install",
                        "build-flatpak",
                        "build-release",
                        "build-release-install",
                        ".flatpak-builder",
                        ".venv",
                        ".dex",
                        "__pycache__",
                        "*.pyc",
                        "dist",
                        "packaging/appimage/AppDir",
                        "packaging/appimage/appimage-build",
                        "subprojects/blueprint-compiler"
                    ]
                }
            ],
            "config-opts": [
                "--libdir=lib"
            ]
        }
    ]
}
